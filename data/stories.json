{"stories":[{"id":"ep1_underwater_secret","title":"The Underwater Secret","title_tr":"Su Altı Sırrı","episode_label":"Episode 1","intro":"Follow Aktapokus on his first big adventure deep in the ocean!","cover":"stories/ep1_underwater_secret/cover.jpg","cards":[{"title":"A Little Octopus","text":["Aktapokus is a little octopus.","He is yellow and very cute.","He lives deep in the ocean."],"image":"stories/ep1_underwater_secret/card01.jpg"},{"title":"Six Arms","text":["Most octopuses have eight arms.","But Aktapokus has six arms.","He is different from the others."],"image":"stories/ep1_underwater_secret/card02.jpg"},{"title":"Hello!","text":["Aktapokus sees some little octopuses.","\"Hello! Can I play with you?\"","\"Yes! Come and play!\""],"image":"stories/ep1_underwater_secret/card03.jpg"},{"title":"The Game","text":["They play a swimming game.","Aktapokus swims very fast.","\"Wow! You are fast!\""],"image":"stories/ep1_underwater_secret/card04.jpg"},{"title":"A Question","text":["Aktapokus is happy.","But he has a question.","\"Why do I have six arms?\""],"image":"stories/ep1_underwater_secret/card05.jpg"},{"title":"An Explorer","text":["Aktapokus loves to explore.","Every day, he swims to new places.","He wants to see the whole ocean."],"image":"stories/ep1_underwater_secret/card06.jpg"},{"title":"Something Strange","text":["One morning, Aktapokus swims very deep.","Suddenly, he sees something strange.","\"What is that?\""],"image":"stories/ep1_underwater_secret/card07.jpg"},{"title":"The Spaceship","text":["Aktapokus swims closer.","It is a small spaceship!","There is a door, and the door is open."],"image":"stories/ep1_underwater_secret/card08.jpg"},{"title":"The Digital Eye","text":["Aktapokus goes inside.","He sees a strange digital eye.","Suddenly, the eye turns on.","BEEP!"],"image":"stories/ep1_underwater_secret/card09.jpg"},{"title":"A New Adventure","text":["The digital eye looks at Aktapokus.","Aktapokus smiles.","\"My adventure starts today.\"","\"HELLO, EXPLORER.\""],"image":"stories/ep1_underwater_secret/card10.jpg"}],"glossary":[{"word":"little","tr":"küçük"},{"word":"ocean","tr":"okyanus"},{"word":"deep","tr":"derin"},{"word":"different","tr":"farklı"},{"word":"swim","tr":"yüzmek"},{"word":"fast","tr":"hızlı"},{"word":"question","tr":"soru"},{"word":"explore","tr":"keşfetmek"},{"word":"strange","tr":"garip / tuhaf"},{"word":"spaceship","tr":"uzay gemisi"},{"word":"explorer","tr":"kâşif"},{"word":"adventure","tr":"macera"}]}]}